# Dependencies
# -----------------------------------------------------------------
# The node_modules folder contains all project dependencies.
# It should never be committed as it can be regenerated by running `npm install`.
/node_modules

# Build output
# -----------------------------------------------------------------
# This folder contains the compiled JavaScript code from your TypeScript source.
# It is generated during the build process.
/dist
/build

# Environment variables
# -----------------------------------------------------------------
# CRITICAL: This file contains secrets like API keys and database credentials.
# Keep this file out of version control for security.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
# -----------------------------------------------------------------
# Log files are generated during runtime and should not be versioned.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / Editor config
# -----------------------------------------------------------------
# Configuration files specific to a developer's editor.
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
# -----------------------------------------------------------------
# System files that can appear in folders.
.DS_Store
Thumbs.db

# Test reports
# -----------------------------------------------------------------
# Reports generated by testing frameworks like Jest.
/coverage
.nyc_output

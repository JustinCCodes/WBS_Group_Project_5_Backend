{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon -r tsconfig-paths/register src/api-server/server.ts",
    "dev:auth": "nodemon -r tsconfig-paths/register src/auth-server/server.ts",
    "dev:frontend": "cd ../ecommerce-frontend && npm run dev",
    "dev:admin": "cd ../ecommerce-admin && npm run dev",
    "dev:tauri": "cd ../ecommerce-admin && npm run tauri dev",
    "dev:all": "concurrently -n \"API,AUTH,SHOP,ADMIN,TAURI\" -c \"cyan,magenta,green,blue,yellow\" \"npm run dev\" \"npm run dev:auth\" \"npm run dev:frontend\" \"npm run dev:admin\" \"npm run dev:tauri\"",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/api-server/server.js",
    "start:auth": "node -r tsconfig-paths/register dist/auth-server/server.js",
    "vercel-build": "echo 'Building TypeScript...' && tsc && tsc-alias && echo 'Build complete!'",
    "start:all": "concurrently -n \"API,AUTH\" -c \"cyan,magenta\" \"npm run start\" \"npm run start:auth\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
